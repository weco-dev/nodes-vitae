## Common Patterns

### Route Data Loading
```typescript
// Use loaders for server-side data fetching
export async function loader({ request }: LoaderFunctionArgs) {
  const userId = await requireUserId(request)
  return json({ user: await getUserById(userId) })
}
```

### Form Handling
```typescript
// Use Conform for type-safe forms
import { conform, useForm } from '@conform-to/react'
import { parseWithZod } from '@conform-to/zod'

export async function action({ request }: ActionFunctionArgs) {
  const formData = await request.formData()
  const submission = parseWithZod(formData, { schema: UserSchema })
  // Handle form submission
}
```

### Authentication Guards
```typescript
// Protect routes requiring authentication
export async function loader({ request }: LoaderFunctionArgs) {
  await requireUserId(request) // Throws if not authenticated
  // Protected route logic
}
```

### Error Handling
